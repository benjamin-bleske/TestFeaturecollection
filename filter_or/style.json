    "title": "LAGIS Flächen",
    "description": "Liegenschaftsflächen (LAGIS) aus Lagis_Flächen_repariert.gpkg, 12.929 Flurstücke, Farbe nach Ressort (104 gruen, 103 blau, 403 orange, GMW violett, 208 tuerkis, 209 magenta, WAW oliv, in Bearbeitung grau, uebrige und leere Ressorts braun). Quelle: Testdatensatz, EPSG:25832 nach EPSG:4326 konvertiert und auf 1 m vereinfacht. Filter nach Ressort (Mehrfachauswahl).",
    "keywords": [
     "carmaconf://infoBoxMapping:function createInfoBoxInfo(p) { function v(x) { return x === null || x === undefined || x === '' ? '<span style=\"color:#bbb;\">—</span>' : String(x); } function row(k, x) { return '<div style=\"display:grid;grid-template-columns:120px 1fr;border-bottom:1px solid #f0f0f0;\"><div style=\"padding:1px 6px;color:#777;\">' + k + '</div><div style=\"padding:1px 6px;color:#222;\">' + v(x) + '</div></div>'; } const table = '<div style=\"font-size:12px;color:#333;\">' + row('Gemarkung', p.gemarkungs) + row('Flur', p.flur) + row('Flurstück', p.fstnr_z + (p.fstnr_n ? '/' + p.fstnr_n : '')) + row('Dienststelle', p.dienststel) + row('Ressort', p.ressort) + row('Abteilung', p.abteilung) + '</div>'; return { header: 'LAGIS-Fläche', headerColor: '#2E7D32', title: 'Flurstück ' + p.flurstueck, subtitle: '<html>' + table + '</html>' }; }",
     "carmaconf://blockLegacyGetFeatureInfo"
